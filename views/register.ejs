<%- include('partials/head') %>

<main class="container">
    <h2>Create an Account</h2>
    
    <!-- Dynamic Error Handling: If an error is passed from the server, display it -->
    <% if (error) { %>
        <div style="background-color: #ff4c4c; color: white; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            <%= error %>
        </div>
    <% } %>

    <!--This form points to the POST /register route-->
    <form action="/register" method="POST">
        <!-- I used inline styles for the form inputs to keep the CSS file cleaner as well as easer debugging -->
        <input type="text" name="username" placeholder="Username" required 
               style="width: 100%; padding: 10px; margin-bottom: 10px; box-sizing: border-box; border-radius: 4px; border: none; background-color: #2c2c2c; color: white;">
        
        <input type="email" name="email" placeholder="Email Address" required 
               style="width: 100%; padding: 10px; margin-bottom: 10px; box-sizing: border-box; border-radius: 4px; border: none; background-color: #2c2c2c; color: white;">
        
        <input type="password" name="password" placeholder="Password" required 
               style="width: 100%; padding: 10px; margin-bottom: 15px; box-sizing: border-box; border-radius: 4px; border: none; background-color: #2c2c2c; color: white;">
        
        <button type="submit" class="btn" style="width: 100%;">Sign Up</button>
    </form>

    <p style="margin-top: 20px; font-size: 0.9rem;">
        Already have an account? <a href="/login" style="color: #4CAF50;">Log in here</a>.
    </p>
</main>

<%- include('partials/footer') %>