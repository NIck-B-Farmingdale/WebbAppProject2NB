<%- include('partials/head') %>

<main class="container">
    <h2>Sign In</h2>
    
    <!--Success messages-->
    <% if (msg) { %>
        <div style="background-color: #4CAF50; color: white; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            <%= msg %>
        </div>
    <% } %>

    <!--Error messages-->
    <% if (error) { %>
        <div style="background-color: #ff4c4c; color: white; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            <%= error %>
        </div>
    <% } %>

    <form action="/login" method="POST">
        <input type="text" name="username" placeholder="Username" required 
               style="width: 100%; padding: 10px; margin-bottom: 10px; box-sizing: border-box; border-radius: 4px; border: none; background-color: #2c2c2c; color: white;">
        
        <input type="password" name="password" placeholder="Password" required 
               style="width: 100%; padding: 10px; margin-bottom: 15px; box-sizing: border-box; border-radius: 4px; border: none; background-color: #2c2c2c; color: white;">
        
        <button type="submit" class="btn" style="width: 100%;">Log In</button>
    </form>

    <p style="margin-top: 20px; font-size: 0.9rem;">
        Need an account? <a href="/register" style="color: #4CAF50;">Register here</a>.
    </p>
</main>

<%- include('partials/footer') %>